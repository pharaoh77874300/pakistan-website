type http_request_result = 
 record {
   body: blob;
   headers: vec http_header;
   status: nat;
 };
type http_header = 
 record {
   name: text;
   value: text;
 };
type _ImmutableObjectStorageRefillResult = 
 record {
   success: opt bool;
   topped_up_amount: opt nat;
 };
type _ImmutableObjectStorageRefillInformation = record {
                                                  proposed_top_up_amount:
                                                   opt nat;};
type _ImmutableObjectStorageCreateCertificateResult = 
 record {
   blob_hash: text;
   method: text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type UserId = principal;
type UpdateProfileInput = 
 record {
   avatar3dConfig: opt text;
   avatarBlob: opt ExternalBlob;
   avatarType: opt text;
   bio: opt text;
   coverBlob: opt ExternalBlob;
   username: opt text;
 };
type TransformationOutput = 
 record {
   body: blob;
   headers: vec http_header;
   status: nat;
 };
type TransformationInput = 
 record {
   context: blob;
   response: http_request_result;
 };
type Timestamp = int;
type RoleEntry = 
 record {
   grantedAt: Timestamp;
   grantedBy: UserId;
   role: AdminRole;
   userId: UserId;
 };
type ProfileView = 
 record {
   avatar3dConfig: opt text;
   avatarBlob: opt ExternalBlob;
   avatarType: text;
   bio: text;
   coverBlob: opt ExternalBlob;
   createdAt: Timestamp;
   followerCount: nat;
   followingCount: nat;
   id: UserId;
   isVerified: bool;
   postCount: nat;
   username: text;
 };
type PostView = 
 record {
   authorId: UserId;
   commentCount: nat;
   content: text;
   createdAt: Timestamp;
   id: PostId;
   imageBlob: opt ExternalBlob;
   likeCount: nat;
   likedByMe: bool;
   privacy: PostPrivacy;
   retweetCount: nat;
 };
type PostPrivacy = 
 variant {
   followersOnly;
   public;
 };
type PostId = nat;
type Page_3 = 
 record {
   items: vec Mention;
   nextOffset: opt nat;
   total: nat;
 };
type Page_2 = 
 record {
   items: vec NotificationView;
   nextOffset: opt nat;
   total: nat;
 };
type Page_1 = 
 record {
   items: vec PostView;
   nextOffset: opt nat;
   total: nat;
 };
type Page = 
 record {
   items: vec ProfileView;
   nextOffset: opt nat;
   total: nat;
 };
type NotificationView = 
 record {
   actorId: UserId;
   createdAt: Timestamp;
   id: nat;
   isRead: bool;
   notifType: NotificationType;
   recipientId: UserId;
   targetPostId: opt PostId;
   targetUserId: opt UserId;
 };
type NotificationType = 
 variant {
   comment;
   follow;
   like;
   mention;
   retweet;
 };
type Mention = 
 record {
   authorId: UserId;
   createdAt: Timestamp;
   mentionedUserId: UserId;
   postId: PostId;
 };
type LockoutStatus = 
 record {
   failedCount: nat;
   locked: bool;
   lockedUntil: opt Timestamp;
 };
type InviteView = 
 record {
   claimedAt: opt Timestamp;
   claimedBy: opt UserId;
   code: text;
   createdAt: Timestamp;
   createdBy: UserId;
   expiresAt: Timestamp;
   status: InviteStatus;
 };
type InviteStatus = 
 variant {
   claimed;
   expired;
   pending;
   revoked;
 };
type FlagView = 
 record {
   createdAt: Timestamp;
   id: nat;
   reason: text;
   reportedBy: UserId;
   resolution: opt text;
   resolvedAt: opt Timestamp;
   resolvedBy: opt UserId;
   status: FlagStatus;
   targetId: nat;
   targetKind: FlagTargetKind;
   targetPrincipal: opt UserId;
 };
type FlagTargetKind = 
 variant {
   comment;
   post;
   user;
 };
type FlagStatus = 
 variant {
   dismissed;
   pending;
   resolved;
 };
type ExternalBlob = blob;
type CreateProfileInput = 
 record {
   avatar3dConfig: opt text;
   avatarBlob: opt ExternalBlob;
   avatarType: opt text;
   bio: text;
   coverBlob: opt ExternalBlob;
   username: text;
 };
type CreatePostInput = 
 record {
   content: text;
   imageBlob: opt ExternalBlob;
   privacy: opt PostPrivacy;
 };
type CommentId = nat;
type Comment = 
 record {
   authorId: UserId;
   content: text;
   createdAt: Timestamp;
   id: CommentId;
   postId: PostId;
 };
type AdminRole = 
 variant {
   moderator;
   owner;
 };
type ActivityLogView = 
 record {
   action: ActionKind;
   id: nat;
   note: opt text;
   performedBy: UserId;
   targetId: opt nat;
   targetPrincipal: opt UserId;
   timestamp: Timestamp;
 };
type ActionKind = 
 variant {
   addModerator;
   claimOwner;
   dismissFlag;
   inviteClaimed;
   inviteRevoked;
   removeComment;
   removeModerator;
   removePost;
   resolveFlag;
   suspendUser;
   tfaFailure;
   tfaLockout;
   tfaResend;
   tfaSuccess;
   unsuspendUser;
 };
service : {
  _immutableObjectStorageBlobsAreLive: (hashes: vec blob) -> (vec bool) query;
  _immutableObjectStorageBlobsToDelete: () -> (vec blob) query;
  _immutableObjectStorageConfirmBlobDeletion: (blobs: vec blob) -> ();
  _immutableObjectStorageCreateCertificate: (blobHash: text) ->
   (_ImmutableObjectStorageCreateCertificateResult);
  _immutableObjectStorageRefillCashier: (refillInformation:
   opt _ImmutableObjectStorageRefillInformation) ->
   (_ImmutableObjectStorageRefillResult);
  _immutableObjectStorageUpdateGatewayPrincipals: () -> ();
  _initializeAccessControl: () -> ();
  addComment: (postId: PostId, content: text) -> (Comment);
  addModerator: (target: UserId) -> ();
  addNotification: (recipientId: UserId, actorId: UserId, notifType:
   NotificationType, targetPostId: opt PostId, targetUserId: opt UserId) ->
   ();
  adminGetMyTelegramChatId: () -> (opt text);
  adminGetTelegramBotToken: () -> (opt text);
  adminGetTfaLockoutStatus: () -> (LockoutStatus);
  adminRegisterTelegramChatId: (chatId: text) -> ();
  adminRemoveComment: (commentId: CommentId, note: opt text) -> ();
  adminRemovePost: (postId: PostId, note: opt text) -> ();
  adminRequestTfaCode: () -> (text);
  adminSetTelegramBotToken: (token: text) -> ();
  adminSetVerified: (userId: UserId, verified: bool) -> ();
  adminSuspendUser: (target: UserId, note: opt text) -> ();
  adminUnsuspendUser: (target: UserId, note: opt text) -> ();
  adminVerifyTfaCode: (code: text) -> (bool);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  blockUser: (targetId: UserId) -> ();
  claimModeratorInvite: (code: text) -> (bool);
  claimOwner: () -> (bool);
  clearAllNotifications: () -> ();
  createModeratorInvite: (code: text) -> (InviteView);
  createPost: (input: CreatePostInput) -> (PostView);
  createProfile: (input: CreateProfileInput) -> (ProfileView);
  deleteComment: (commentId: CommentId) -> ();
  deletePost: (postId: PostId) -> ();
  dismissFlag: (flagId: nat, note: opt text) -> ();
  flagComment: (commentId: CommentId, reason: text) -> (nat);
  flagPost: (postId: PostId, reason: text) -> (nat);
  flagUser: (target: UserId, reason: text) -> (nat);
  followUser: (target: UserId) -> ();
  getBlockedUsers: () -> (vec UserId) query;
  getCallerUserProfile: () -> (opt ProfileView) query;
  getCallerUserRole: () -> (UserRole) query;
  getFeed: (offset: nat, limit: nat) -> (Page_1) query;
  getFlag: (flagId: nat) -> (opt FlagView) query;
  getFollowers: (userId: UserId) -> (vec UserId) query;
  getFollowing: (userId: UserId) -> (vec UserId) query;
  getFollowingIds: () -> (vec UserId) query;
  getMentionsForUser: (userId: UserId, offset: nat, limit: nat) ->
   (Page_3) query;
  getModeratorInvite: (code: text) -> (opt InviteView) query;
  getMutedUsers: () -> (vec UserId) query;
  getMyAdminRole: () -> (opt AdminRole) query;
  getMyNotifications: (offset: nat, limit: nat) -> (Page_2);
  getMyProfile: () -> (opt ProfileView) query;
  getOwner: () -> (opt UserId) query;
  getPinnedPosts: (userId: UserId) -> (vec PostId) query;
  getPost: (postId: PostId) -> (opt PostView) query;
  getProfile: (userId: UserId) -> (opt ProfileView) query;
  getProfileByUsername: (username: text) -> (opt ProfileView) query;
  getUnreadCount: () -> (nat) query;
  getUserProfile: (user: UserId) -> (opt ProfileView) query;
  isBlocked: (targetId: UserId) -> (bool) query;
  isCallerAdmin: () -> (bool) query;
  isFollowing: (target: UserId) -> (bool) query;
  isMuted: (targetId: UserId) -> (bool) query;
  isUserSuspended: (userId: UserId) -> (bool) query;
  listActivityLog: (offset: nat, limit: nat) -> (vec ActivityLogView) query;
  listAllPosts: (offset: nat, limit: nat) -> (Page_1) query;
  listComments: (postId: PostId) -> (vec Comment) query;
  listFlags: (status: opt FlagStatus) -> (vec FlagView) query;
  listModeratorInvites: (pendingOnly: bool) -> (vec InviteView) query;
  listModerators: () -> (vec RoleEntry) query;
  listPostsByUser: (userId: UserId, offset: nat, limit: nat) ->
   (Page_1) query;
  listProfiles: (offset: nat, limit: nat) -> (Page) query;
  markAllNotificationsRead: () -> ();
  markNotificationRead: (notifId: nat) -> ();
  muteUser: (targetId: UserId) -> ();
  pinPost: (postId: PostId) -> ();
  removeModerator: (target: UserId) -> ();
  resolveFlag: (flagId: nat, note: opt text) -> ();
  revokeModeratorInvite: (code: text) -> (bool);
  saveCallerUserProfile: (input: CreateProfileInput) -> ();
  searchPosts: (keyword: text) -> (vec PostView) query;
  searchUsers: (keyword: text) -> (vec ProfileView) query;
  toggleLike: (postId: PostId) -> (nat, bool);
  transformWrapper: (input: TransformationInput) ->
   (TransformationOutput) query;
  unblockUser: (targetId: UserId) -> ();
  unfollowUser: (target: UserId) -> ();
  unmuteUser: (targetId: UserId) -> ();
  unpinPost: (postId: PostId) -> ();
  updateProfile: (input: UpdateProfileInput) -> (ProfileView);
}
